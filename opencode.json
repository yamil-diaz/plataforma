{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "omniroute": {
      "name": "OmniRoute",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:20128/v1"
      },
      "models": {
        "oc/nemotron-3-ultra-free": {
          "name": "Nemotron 3 Ultra Free",
          "modelID": "nemotron-3-ultra-free",
          "reasoning": true
        },
        "oc/mimo-v2.6-flash-free": {
          "name": "MiMo V2.6 Flash Free",
          "modelID": "mimo-v2.6-flash-free",
          "reasoning": true
        },
        "kiro/claude-sonnet-4.5": {
          "name": "Claude Sonnet 4.5 (Kiro free)",
          "modelID": "kiro/claude-sonnet-4.5",
          "reasoning": true
        },
        "kiro/claude-haiku-4.5": {
          "name": "Claude Haiku 4.5 (Kiro free)",
          "modelID": "kiro/claude-haiku-4.5",
          "reasoning": true
        }
      }
    }
  },
  "model": "omniroute/oc/mimo-v2.6-flash-free",
  "permission": {
    "bash": {
      "ssh *": "allow",
      "docker *": "allow",
      "curl *": "allow",
      "nslookup *": "allow",
      "Resolve-DnsName *": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "*": "ask"
    }
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--browser", "chromium"],
      "enabled": true,
      "environment": {}
    }
  }
}
